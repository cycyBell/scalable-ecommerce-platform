# ==============================================================================
# SHOPPING CART SERVICE ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# This file serves as a reference template for environment variables required by
# the Shopping Cart Microservice. Never commit actual secret values (like real
# API keys or production database passwords) to git repository templates!
# ==============================================================================

# Application Port: The port Express listens on when running locally outside Docker.
PORT=8002

# Node Environment: 'development', 'test', or 'production'. Controls logging & optimizations.
NODE_ENV=development

# Redis Connection Settings: Redis acts as the volatile, fast in-memory store for cart items.
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=supersecret_redis_password_2026

# Shared JWT Secret: MUST match the exact secret used by user-service to sign tokens!
# This allows shopping-cart-service to verify identity without querying PostgreSQL.
JWT_SECRET=8d/vpFSCAFqeRdZD7W2ZbBUbvs9r3FajrfXlCDp4cTk=

# Product Catalog Microservice Base URL: Used to verify product stock & fetch current pricing.
PRODUCT_CATALOG_URL=http://localhost:8000
